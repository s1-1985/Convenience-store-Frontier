{
  "name": "convenience-store-frontier",
  "version": "0.1.0",
  "private": true,
  "description": "Convenience-store Frontier - 30-day vertical slice simulation and browser UI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:core": "tsc -p tsconfig.json --noEmit false --outDir dist-core",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "npm run build:core && node dist-core/balance/runBenchmark.js --seeds=100 --format=both",
    "balance:ci": "npm run build:core && node dist-core/balance/runBenchmark.js --seeds=8 --format=summary"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.4"
  }
}
